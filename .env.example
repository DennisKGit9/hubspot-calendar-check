# All values are optional — sensible defaults are baked in.
# Copy to `.env` for local runs (python-dotenv loads it automatically).

# The HubSpot meetings link slug (the part after the domain).
HUBSPOT_SLUG=dennis-kwiatkowski

# Regional HubSpot API gateway serving the public meetings endpoints.
# EU portals: https://api-eu1.hubapi.com   US portals: https://api.hubapi.com
HUBSPOT_API_BASE=https://api-eu1.hubapi.com
HUBSPOT_AVAILABILITY_PATH=/meetings-public/v3/book/availability-page

# Public meetings page host (used for Referer/Origin request headers).
HUBSPOT_REFERER_BASE=https://meetings-eu1.hubspot.com

# Number of monthly availability pages to fetch (monthOffset 0..N-1).
MONTHS_AHEAD=3

# Working-hours window (local Berlin time) that booked blocks are clipped to.
WORK_START_HOUR=9
WORK_END_HOUR=18

# Comma-separated weekday numbers to consider (Mon=0 ... Sun=6). Default Mon-Fri.
WORK_DAYS=0,1,2,3,4

# Timezone the link operates in, and the local hour the daily run should fire.
TIMEZONE=Europe/Berlin
TARGET_HOUR=19

# Output path for the generated feed and the subscribed calendar's display name.
OUTPUT_PATH=output/busy.ics
CALENDAR_NAME=HubSpot Busy
